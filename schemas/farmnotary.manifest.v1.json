{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dooders/FarmNotary/schemas/farmnotary.manifest.v1.json",
  "title": "farmnotary.manifest.v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "created_utc",
    "git_sha",
    "config",
    "artifacts",
    "artifact_hashes",
    "publish_patterns",
    "unmatched_count"
  ],
  "properties": {
    "schema": { "const": "farmnotary.manifest.v1" },
    "farm_notary_version": { "type": "string" },
    "created_utc": { "type": "string" },
    "git_sha": { "type": ["string", "null"] },
    "git_dirty": { "type": ["boolean", "null"] },
    "runner": { "type": "string" },
    "command": { "type": "string" },
    "environment": { "type": "object" },
    "config": { "type": "object" },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "publish_patterns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "publish_profile": { "type": "string" },
    "unmatched_count": { "type": "integer", "minimum": 0 },
    "withheld_salt": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "withheld_root": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "withheld_classes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["count", "reason"],
        "properties": {
          "count": { "type": "integer", "minimum": 0 },
          "reason": { "type": "string" }
        }
      }
    },
    "derived_from": { "type": "array" },
    "precommit_hash": { "type": "string" },
    "beacon": { "type": "object" },
    "ci_provenance": { "type": "object" },
    "official_record": { "type": "object" },
    "cid": { "type": "string" },
    "cid_reachable": { "type": "boolean" },
    "cid_reachable_checked_utc": { "type": "string" },
    "pin_service": { "type": "string" },
    "anchor": { "type": "object" },
    "identity": {
      "type": "object",
      "description": "Stamp field. Excluded from content_hash. Optional SSH/minisign signature of the content hash."
    }
  }
}
